# Frontend build-time variables (Vite). Copy to frontend/.env.local for dev,
# or set them in the environment that runs `npm run build` for production.

# Base URL for the API, including the /api suffix.
#   unset + dev:   http://localhost:8000/api  (via the Vite proxy)
#   unset + build: /api  (relative — only correct if the static host proxies /api)
#   production:    the Railway backend URL, e.g. https://<service>.up.railway.app/api
VITE_API_BASE_URL=

# Public base path the built app is served from. Must have a trailing slash.
#   root deploy:      /
#   isosavi.com:      /test/actris-monitor/
VITE_BASE_PATH=/
