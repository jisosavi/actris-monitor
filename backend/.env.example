# Backend environment variables. Copy to backend/.env for local reference —
# note main.py does not auto-load .env, so export these or set them in your
# run configuration (.vscode/launch.json already does for native runs).

# Where the SQLite database lives.
#   Railway:        /data/actris.db  (mounted volume)
#   docker-compose: /data/actris.db  (named volume actris-db)
#   native local:   ./data/actris.db (relative to backend/; gitignored)
# The code default is /data/actris.db, which fails natively on macOS because
# /data is not writable — always set this when running outside a container.
DATABASE_PATH=./data/actris.db

# Comma-separated allowed CORS origins. Defaults to "*" if unset.
# Production should be the real frontend origin, not "*".
ALLOWED_ORIGIN=http://localhost:5173
